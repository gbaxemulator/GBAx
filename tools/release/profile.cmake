# Reproducible desktop release profile. SDL powers Qt audio/controllers;
# the separate SDL command-line frontend is not part of these downloads.
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(BUILD_QT ON CACHE BOOL "")
set(FORCE_QT_VERSION 6 CACHE STRING "")
set(BUILD_SDL ON CACHE BOOL "")
set(SDL_VERSION 2 CACHE STRING "")
set(BUILD_SDL_FRONTEND OFF CACHE BOOL "")
set(BUILD_UPDATER OFF CACHE BOOL "")
set(BUILD_SHARED OFF CACHE BOOL "")
set(BUILD_STATIC ON CACHE BOOL "")
set(USE_ZLIB ON CACHE BOOL "")
set(USE_PNG ON CACHE BOOL "")
set(USE_SQLITE3 ON CACHE BOOL "")
set(USE_LIBZIP ON CACHE BOOL "")
set(USE_MINIZIP OFF CACHE BOOL "")
set(USE_LZMA ON CACHE BOOL "")
# Optional integrations are excluded from the initial portable packages.
set(USE_FFMPEG OFF CACHE BOOL "")
set(USE_DISCORD_RPC OFF CACHE BOOL "")
set(USE_EDITLINE OFF CACHE BOOL "")
set(USE_ELF OFF CACHE BOOL "")
set(ENABLE_SCRIPTING OFF CACHE BOOL "")
set(USE_LUA OFF CACHE BOOL "")
set(USE_JSON_C OFF CACHE BOOL "")
set(USE_FREETYPE OFF CACHE BOOL "")
